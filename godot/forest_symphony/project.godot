config_version=5

[application]
config/name="Forest Symphony | Godot-first A36 80x58 large continuous Ground-first forest"
run/main_scene="res://scenes/a36_large_verdant_forest_80x58.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=544
window/size/viewport_height=416
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[physics]
2d/default_gravity=0.0
