  "rules": [
    {
      "id": "R8-001",
      "text": "Ground remains full original beautiful master. PAR RGB must be copied from same source at exactly aligned coordinates."
    },
    {
      "id": "R8-002",
      "text": "Every user RED ring is a mandatory occluder instance, including small independent bushes, plants, rocks. Absence of coverage => FAIL."
    },
    {
      "id": "R8-003",
      "text": "User BLUE ring is ground / stairs, explicitly excluded. Any PAR alpha in the actual step surface => FAIL."
    },
    {
      "id": "R8-004",
      "text": "32px tile grid is a selection guide; mixed cells require alpha masks, not full opaque 32px tiles."
    },
    {
      "id": "R8-005",
      "text": "No minimum area filter for micro objects. Evaluate individual ID, source mask ownership, contact depth and four actor directions."
    },
    {
      "id": "R8-006",
      "text": "Mask complement cannot prove missing-area correctness; only independent visual annotation and native VX play can pass Art Gate F."
    },
    {
      "id": "R8-007",
      "text": "Static objects may use HK PAR; dynamic depth objects require per-player/NPC order; collision limits unreachable positions."
    },
    {
      "id": "R8-008",
      "text": "Use exact original Master visibility; no repainting Ground. Unknown object and source overlaps are reported, not silently erased."
    }
