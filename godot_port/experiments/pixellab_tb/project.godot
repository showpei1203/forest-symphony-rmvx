; Engine configuration file.
; Forest Symphony T-B independent candidate scene, no main project changes.
config_version=5

[application]
config/name="FS T-B Monster Family Candidate"
run/main_scene="res://tb_demo.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=900
window/size/viewport_height=580
window/size/window_width_override=900
window/size/window_height_override=580

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
