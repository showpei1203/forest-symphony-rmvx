config_version=5

[application]
config/name="Forest Symphony - Godot Migration P1 (WIP)"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=544
window/size/viewport_height=416
window/size/window_width_override=1088
window/size/window_height_override=832
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[gui]
theme/default_font_size=14
